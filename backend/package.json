{
  "name": "@bio-majesty/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS CDK infrastructure and Lambda handlers for the Prodia exec dashboard.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "synth": "cdk synth --quiet",
    "deploy": "cdk deploy --all",
    "diff": "cdk diff",
    "synth:github-ci": "cdk synth --quiet --app \"npx tsx bin/github-ci.ts\"",
    "deploy:github-ci": "cdk deploy --app \"npx tsx bin/github-ci.ts\"",
    "smoke:models": "tsx scripts/smoke-models.ts",
    "eval:tagging": "tsx scripts/eval-tagging.ts",
    "try:classify": "tsx scripts/try-classify.ts",
    "export:feedback": "tsx scripts/export-feedback.ts",
    "migrate:editions": "tsx scripts/migrate-editions.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/google": "^4.0.95",
    "@ai-sdk/openai": "^4.0.93",
    "@ai-sdk/provider": "^4.0.27",
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1154.0",
    "@aws-sdk/client-dynamodb": "^3.1151.0",
    "@aws-sdk/client-lambda": "^3.1151.0",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/client-s3vectors": "^3.1151.0",
    "@aws-sdk/client-secrets-manager": "^3.1151.0",
    "@aws-sdk/client-sfn": "^3.1151.0",
    "@aws-sdk/lib-dynamodb": "^3.1151.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@bio-majesty/shared": "*",
    "@mozilla/readability": "^0.6.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.139",
    "fast-xml-parser": "^5.11.2",
    "linkedom": "^0.18.13",
    "yahoo-finance2": "^4.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.0.0",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.273.0",
    "aws-sdk-client-mock": "^4.1.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
